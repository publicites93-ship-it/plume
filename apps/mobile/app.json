{
  "expo": {
    "name": "Plume",
    "slug": "plume",
    "version": "0.3.2",
    "scheme": "plume",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "app.plume.reader",
      "versionCode": 5,
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0B111C",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.plume.reader"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B111C"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Plume accède à vos photos uniquement pour choisir la couverture d'une histoire.",
          "cameraPermission": false,
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#0B111C",
            "cropToolbarIconColor": "#E9D8B4",
            "cropToolbarActionTextColor": "#E9D8B4",
            "cropBackButtonIconColor": "#E9D8B4",
            "cropBackgroundColor": "#0B111C"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#0B111C",
              "cropToolbarIconColor": "#E9D8B4",
              "cropToolbarActionTextColor": "#E9D8B4",
              "cropBackButtonIconColor": "#E9D8B4",
              "cropBackgroundColor": "#0B111C"
            }
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "armeabi-v7a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true
          }
        }
      ]
    ],
    "extra": {
      "privacyPolicyUrl": "https://plume-api-qk9s.onrender.com/confidentialite",
      "apiUrl": "",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bf9deba1-fbc4-4650-8f7f-dcdc9d94cdd0"
      }
    },
    "owner": "st93"
  }
}
