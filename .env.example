# ---------------------------------------------------------------------------
# Plume — exemple de configuration. Copier en .env puis compléter localement.
# Ne JAMAIS committer de secret réel.
# ---------------------------------------------------------------------------

# API
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Origines autorisées (séparées par des virgules). * uniquement en développement.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Base de données
# Sans DATABASE_URL, l'API utilise PGlite (PostgreSQL embarqué) dans apps/api/data/.
# En production, fournir une URL PostgreSQL classique :
# DATABASE_URL=postgresql://plume:plume@localhost:5432/plume
DATABASE_URL=

# Authentification — générer avec: openssl rand -base64 48
JWT_SECRET=change-me-in-production-with-a-long-random-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Fournisseur IA. "mock" est déterministe, gratuit et clairement signalé.
# Aucun appel payant n'est effectué sans validation explicite.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Application mobile (Expo) — URL vue depuis le téléphone.
# Sur un appareil physique, remplacer localhost par l'IP LAN de la machine.
EXPO_PUBLIC_API_URL=http://localhost:4000/trpc
